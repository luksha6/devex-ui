{
  "name": "@devex/ui",
  "version": "0.1.0",
  "description": "React design system for engineering docs. Human layout and agent markdown from the same source.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luksha6/devex-ui.git"
  },
  "bugs": {
    "url": "https://github.com/luksha6/devex-ui/issues"
  },
  "homepage": "https://github.com/luksha6/devex-ui#readme",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./docs": {
      "types": "./dist/docs/index.d.ts",
      "import": "./dist/docs/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19",
    "react-dom": "^18.3.0 || ^19"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && cp src/tokens/*.css dist/ && node scripts/strip-css-from-dts.mjs",
    "prepare": "npm run build",
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.css\" && prettier --check . && node scripts/ban-hex.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@storybook/addon-a11y": "^8.6.4",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/manager-api": "^8.6.4",
    "@storybook/react": "^8.6.4",
    "@storybook/react-vite": "^8.6.4",
    "@storybook/theming": "^8.6.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.4",
    "stylelint": "^16.14.1",
    "stylelint-config-standard": "^37.0.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
